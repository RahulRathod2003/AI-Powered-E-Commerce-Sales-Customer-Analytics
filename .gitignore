__pycache__/
*.py[cod]
*.pyo
*.pyd

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db

# --- Build / dist ---
*.egg-info/
dist/
build/

# --- Local dataset files (keep out of version control) ---
